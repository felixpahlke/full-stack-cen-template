# See .docs/oc-deployment.md for detailed deployment documentation
# See scripts/README.md for technical details

# Deployment Flavor: local-auth, backend-only, oauth-proxy, backend-only-no-db, local-auth-custom-ui, oauth-proxy-custom-ui
DEPLOYMENT_FLAVOR=backend-only

# Application Identity
APP_NAME=my-app
PROJECT_NAME=my-openshift-project
ENVIRONMENT=production

# Git Repository
GIT_SSH_URL=git@github.com:username/repository.git
# Optional but recommended (check .docs/oc-deployment.md for details)
GITHUB_TOKEN=
GITHUB_HOST=github.ibm.com

# API Key (backend-only, backend-only-no-db) - must be 16, 32, or 64 characters
API_KEY=changethis1234567890

# Database (all except backend-only-no-db)
POSTGRES_SERVER=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Deployment (Optional)
DEPLOYMENT_BRANCH_FILTER=
BACKEND_CORS_ORIGINS=

# Custom Variables (Optional - will be available to the backend)
# CUSTOM_VAR=custom-value
