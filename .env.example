# Flavor and runtime
CEN_FLAVOR=oauth-proxy-custom-ui
ENVIRONMENT=local
PROJECT_NAME="OAuth Proxy CEN App"

# The backend migrates to the bundled Alembic head before serving. Set false only
# when migrations are owned out of band; startup still requires an exact head match.
MIGRATE_ON_START=true

# Maximum wait for another replica to release the migration advisory lock.
MIGRATION_LOCK_TIMEOUT_SECONDS=60

# Native FastAPI/Vite and development service ports
API_PORT=8000
WEB_PORT=5173
DB_PORT=5432
ADMINER_PORT=8080
DEX_PORT=5556
OAUTH2_PROXY_PORT=4180

# Browser requests stay same-origin through oauth2-proxy and Vite.
VITE_API_URL=
BACKEND_CORS_ORIGINS=

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Local Dex/oauth2-proxy. `pnpm run dev` replaces each marker in .env with a
# strong per-checkout value. These placeholders are intentionally unusable.
OAUTH2_PROXY_CLIENT_ID=full-stack-cen-template
OAUTH2_PROXY_CLIENT_SECRET=changethis
OAUTH2_PROXY_COOKIE_SECRET=changethis
OAUTH2_PROXY_UPSTREAM_PASSWORD=changethis
OAUTH2_PROXY_COOKIE_SECURE=false

# Leave these blank for the bundled zero-configuration Dex issuer. To use an external IdP,
# set its issuer URL and client credentials. Redirect, well-known, and cookie domain retain the
# pre-modernization local-development contract and are optional.
OAUTH2_PROXY_OIDC_ISSUER_URL=
OAUTH2_PROXY_REDIRECT_URL=
OAUTH2_PROXY_WELL_KNOWN_URL=
OAUTH2_PROXY_COOKIE_DOMAIN=

# Public, local-only Dex test fixture used by Playwright.
DEX_TEST_USER_EMAIL=admin@example.com
DEX_TEST_USER_USERNAME=admin
DEX_TEST_USER_ID=11111111-1111-1111-1111-111111111111
DEX_TEST_USER_PASSWORD=changethis
DEX_TEST_USER_PASSWORD_HASH='$2y$10$r3ZbbkkzY1kbxmyVqyRdFu/bX.xsgj3Yqv/pBEoEZNCguuOUt0Mb6'

# Playwright derives its base URL and credentials from this root contract.
PLAYWRIGHT_EXTERNAL_SERVER=false

# We just track which flavor you're using. We want to find out, which flavors are being used.
VITE_TELEMETRY_ENABLED=true
