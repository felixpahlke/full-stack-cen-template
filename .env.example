# Flavor and runtime
CEN_FLAVOR=oauth-proxy-custom-ui
ENVIRONMENT=local
PROJECT_NAME="OAuth Proxy CEN App"

# Native FastAPI/Vite and development service ports
API_PORT=8000
WEB_PORT=5173
DB_PORT=5432
ADMINER_PORT=8080
DEX_PORT=5556
OAUTH2_PROXY_PORT=4180

# Browser requests stay same-origin through oauth2-proxy and Vite.
VITE_API_URL=
BACKEND_CORS_ORIGINS=

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Local Dex/oauth2-proxy. `npm run dev` replaces each marker in .env with a
# strong per-checkout value. These placeholders are intentionally unusable.
OAUTH2_PROXY_CLIENT_ID=full-stack-cen-template
OAUTH2_PROXY_CLIENT_SECRET=generate-on-first-dev-run
OAUTH2_PROXY_COOKIE_SECRET=generate-on-first-dev-run
OAUTH2_PROXY_UPSTREAM_PASSWORD=generate-on-first-dev-run
OAUTH2_PROXY_COOKIE_SECURE=false

# Public, local-only Dex test fixture used by Playwright.
DEX_TEST_USER_EMAIL=admin@example.com
DEX_TEST_USER_PASSWORD=ChangeMe

# Playwright derives its base URL and credentials from this root contract.
PLAYWRIGHT_EXTERNAL_SERVER=false

# We just track which flavor you're using. We want to find out, which flavors are being used.
VITE_TELEMETRY_ENABLED=true
