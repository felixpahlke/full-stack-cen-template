# Deployment Flavor
# Valid options: local-auth, backend-only, oauth-proxy, backend-only-no-db, local-auth-custom-ui, oauth-proxy-custom-ui
# Default: local-auth (full stack with local authentication)
CEN_FLAVOR=local-auth

# Environment: local, staging, production
ENVIRONMENT=local

# The backend migrates to the bundled Alembic head before serving. Set false only
# when migrations are owned out of band; startup still requires an exact head match.
MIGRATE_ON_START=true

# Maximum wait for another replica to release the migration advisory lock.
MIGRATION_LOCK_TIMEOUT_SECONDS=60

# Optional: Override log level for backend
# LOG_LEVEL=

PROJECT_NAME="Full Stack FastAPI Project"

# Local service ports
API_PORT=8000
WEB_PORT=5173
DB_PORT=5432
ADMINER_PORT=8080

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,http://localhost:5174,https://localhost,https://localhost:5173,https://localhost:5174"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
SIGNUP_ACCESS_PASSWORD=changethis

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Flavor tracking
# We just track which flavor you're using. We want to find out, which flavors are being used.
VITE_TELEMETRY_ENABLED=true
